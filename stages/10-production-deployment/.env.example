# Local development example only. Do not commit real secrets.
TINY_AGENT_ENVIRONMENT=dev
TINY_AGENT_MAX_CONCURRENCY=4
TINY_AGENT_QUEUE_TIMEOUT_SECONDS=0.25
TINY_AGENT_REQUEST_TIMEOUT_SECONDS=30
TINY_AGENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable
TINY_AGENT_REDIS_URL=redis://localhost:6379/0
# TINY_AGENT_MODEL_API_KEY=inject-this-from-your-secret-system
